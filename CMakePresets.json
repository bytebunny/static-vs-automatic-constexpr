{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "base",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "base",
      "configuration": "Release"
    }
  ]
}